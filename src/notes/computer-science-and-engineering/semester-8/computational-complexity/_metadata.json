    "syllabusModules": [
      {
        "module": 1,
        "topics": [
          "Introduction to Complexity Theory - Basic concepts and motivations",
          "Deterministic and nondeterministic models",
          "Turing machines",
          "computational models.",
          "Complexity Classes P and NP - Definitions and examples of P and NP",
          "Polynomial-time algorithms",
          "NP-completeness and the Cook-Levin theorem.",
          "Reductions and Completeness - Polynomial-time reductions",
          "NP-complete problems",
          "their significance",
          "Examples of NP-complete problems"
        ],
        "contactHours": 9,
        "textbookReferences": [
          "Text 2 - Ch 7",
          "Text 2 - Ch 7, 8",
          "Text 1 - Ch 2"
        ]
      },
      {
        "module": 2,
        "topics": [
          "Space Complexity - Space complexity classes: L, NL, PSPACE",
          "Savitch's theorem and NL-completeness",
          "PSPACE-completeness.",
          "Polynomial Hierarchy and Alternation - Definition of the polynomial hierarchy (PH)",
          "Complete problems for each level of PH",
          "Relationship between PH and other classes."
        ],
        "contactHours": 9,
        "textbookReferences": [
          "Text  2 - Ch 8",
          "Text 1 - Ch 5"
        ]
      },
      {
        "module": 3,
        "topics": [
          "Interactive Proofs - Definition and examples of interactive proofs",
          "IP = PSPACE theorem",
          "Zero-knowledge proofs.",
          "Probabilistically Checkable Proofs (PCPs) - Introduction to PCPs",
          "PCP theorem and implications",
          "Applications in hardness of approximation."
        ],
        "contactHours": 9,
        "textbookReferences": [
          "Text 1 - Ch 8",
          "Text 1 - Ch 9"
        ]
      },
      {
        "module": 4,
        "topics": [
          "Circuit Complexity - Boolean circuits and circuit complexity",
          "Circuit lower bounds",
          "Complexity of specific functions.",
          "Quantum Complexity - Basics of quantum computation",
          "Quantum complexity classes: BQP, QMA",
          "Quantum algorithms and their complexity."
        ],
        "contactHours": 9,
        "textbookReferences": [
          "Text 2 - Ch 9",
          "Text 3 - Ch 10, 11"
        ]
      }
    ],
