          "ID3",
          "Attribute selection measures",
          "Naive Bayesian Classification.",
          "Clustering - K-Means",
          "Agglomerative  versus Divisive Hierarchical Clustering",
          "BIRCH",
          "DBSCAN."
        ],
        "contactHours": 9,
        "textbookReferences": []
      },
      {
        "module": 4,
        "topics": [
