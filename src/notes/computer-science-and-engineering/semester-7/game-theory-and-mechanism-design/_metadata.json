      {
        "module": 1,
        "topics": [
          "Introduction to Game Theory - Competitive equilibrium",
          "Rationality",
          "Strategic Games - Dominance",
          "Nash equilibrium",
          "Maxmin strategies",
          "elimination of dominated strategies",
          "preservation of pure Nash equilibrium (PSNE)",
