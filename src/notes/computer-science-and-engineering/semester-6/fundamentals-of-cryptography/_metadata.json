          "Transposition techniques",
          "Traditional Block Cipher Structure."
        ],
        "contactHours": 8,
        "textbookReferences": []
      },
      {
        "module": 3,
        "topics": [
          "The Data Encryption Standard - DES Encryption & Decryption",
