    "courseOutcomes": [
      {
        "CO": "CO1",
        "description": "To understand the dynamic nature of earth, the associated surface and subsurface processes",
        "knowledgeLevel": "K2"
      },
      {
        "CO": "CO2",
        "description": "To understand basic knowledge about different minerals, various rocks and their classification & identification and their significance in civil engineering.",
        "knowledgeLevel": "K2"
      },
      {
        "CO": "CO3",
        "description": "To apply basic knowledge about ground water and identify the problems created by ground water for civil engineering projects",
        "knowledgeLevel": "K3"
      },
      {
        "CO": "CO4",
        "description": "To analyse the process involved in rock deformation and formation of various geological structures such as folds, faults, joints unconformities and their critical aspects in stability of civil engineering structures.",
        "knowledgeLevel": "K4"
      },
      {
        "CO": "CO5",
        "description": "To evaluate geological knowledge in planning, designing and construction of various civil projects",
        "knowledgeLevel": "K5"
      }
    ],
